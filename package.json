{
  "name": "edu-video-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal bilingual (ID/EN) educational episode compiler: source-backed long-form master + Shorts, rendered on GitHub Actions.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "tsx src/cli.ts validate",
    "tts": "tsx src/cli.ts tts",
    "plan": "tsx src/cli.ts plan",
    "describe": "tsx src/cli.ts describe",
    "matrix": "tsx src/cli.ts matrix",
    "topic": "tsx src/cli.ts topic",
    "font": "node scripts/ensure-font.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run validate",
    "studio": "remotion studio remotion/index.ts",
    "render:long": "remotion render remotion/index.ts LongForm",
    "render:short": "remotion render remotion/index.ts Short"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.546",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.546",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
